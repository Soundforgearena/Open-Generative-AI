# Every value here must be set in the Railway service, not committed.
# NEXT_PUBLIC_* values are inlined by Next at build time, so the Dockerfile
# declares them as build ARGs and Railway must redeploy after any change.

# ---------------------------------------------------------------- site
NEXT_PUBLIC_APP_NAME=CinexVideo
NEXT_PUBLIC_SITE_URL=https://cinexvideo.app
NEXT_PUBLIC_APP_URL=https://cinexvideo.app
CINEXVIDEO_MAINTENANCE_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# ---------------------------------------------------------------- supabase
# Required for sign-in, credits, admin access and every authenticated route.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- generation
# MuAPI runs the actual video and image generation. Without MUAPI_API_KEY the
# generate, job-polling and reconcile routes fail with a configuration error.
MUAPI_API_KEY=
MUAPI_BASE_URL=https://api.muapi.ai

# AI Director. Without OPENAI_API_KEY the Director returns a configuration error.
OPENAI_API_KEY=
OPENAI_DIRECTOR_MODEL=gpt-5

# ---------------------------------------------------------------- payments
# Checkout, credit purchases, the webhook that grants credits, and the
# admin Stripe readiness screen all read these.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The webhook route accepts either name; CINEXVIDEO_ takes precedence.
STRIPE_WEBHOOK_SECRET=
CINEXVIDEO_STRIPE_WEBHOOK_SECRET=
# Used by the readiness check to build the expected webhook URL. Falls back to
# NEXT_PUBLIC_SITE_URL, then NEXT_PUBLIC_APP_URL.
APP_URL=https://cinexvideo.app
# Guard rail: a live Stripe account is refused unless this is explicitly true.
STRIPE_LIVE_MODE=false
STRIPE_CURRENCY=usd
STRIPE_PARTNER_COUNTRY=US

# ---------------------------------------------------------------- other
# Paid export routes stay disabled unless this is exactly "true".
ENABLE_PAID_EXPORTS=false
# Shared bearer token for the admin cron routes.
CRON_SECRET=
